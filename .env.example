# EmpowerTours Backend Configuration

# SQLite database file path
DATABASE_PATH=./empowertours.db

# Monad RPC endpoint
MONAD_RPC_URL=https://rpc.monad.xyz

# Deployer wallet private key (hex, no 0x prefix)
DEPLOYER_PRIVATE_KEY=

# JWT signing secret for authentication tokens
JWT_SECRET=

# EmpowerTours Membership NFT contract address on Monad
MEMBERSHIP_NFT_ADDRESS=

# EmpowerStudioPayments contract address on Monad
PAYMENTS_CONTRACT_ADDRESS=

# Stripe (traditional payments for App Store compliance)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# HTTP server port
PORT=8080
